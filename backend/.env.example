# Flask
PORT=5000
FLASK_DEBUG=1
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Bootstrap admin account (created on first run)
# Permanent master admin (never commit real values)
MASTER_ADMIN_ID=
MASTER_ADMIN_PASSWORD=

ADMIN_ID=ADMIN001
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Portal Administrator

# Lovable Google Drive connector (managed in Project Settings -> Connectors)
LOVABLE_API_KEY=
GOOGLE_DRIVE_API_KEY=
DRIVE_ROOT_FOLDER=STUDENTS KA NOTES SHARING HUB

# Uploads
MAX_UPLOAD_MB=25

# SMTP (for face-verification confirmation emails)
# Gmail example: host=smtp.gmail.com, user=your@gmail.com, password=App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studentsnotessharing@gmail.com
SMTP_PASSWORD=
SMTP_FROM=studentsnotessharing@gmail.com
