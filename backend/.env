# Flask
PORT=5000
FLASK_DEBUG=1
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Bootstrap admin account (created on first run)
ADMIN_ID=ADMIN001
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Portal Administrator

# Google Drive service account
# Path to the downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Optional: ID of a Drive folder shared with the service account.
# The "STUDENTS KA NOTES SHARING HUB" root folder is created inside it.
GOOGLE_DRIVE_PARENT_ID=
DRIVE_ROOT_FOLDER=STUDENTS KA NOTES SHARING HUB

# Uploads
MAX_UPLOAD_MB=25