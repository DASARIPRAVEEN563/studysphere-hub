# ---- Frontend (Vite) ----
# Copy to .env and fill in. Only VITE_* vars reach the browser.

# Flask backend URL (local dev, or your Render URL in production)
VITE_API_URL=https://sknsh-backend.onrender.com

# Lovable Cloud (backend/database) — auto-generated when Cloud is enabled.
# If the project is re-enabled in another workspace, these change.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
